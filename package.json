{
  "name": "@siamriaz/octomux",
  "version": "1.0.0",
  "description": "Enterprise-grade cross-platform GitHub multi-account, SSH identity, and smart clone manager",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "octomux": "./dist/bin/octomux.js",
    "omx": "./dist/bin/octomux.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/bin/octomux.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "github",
    "git",
    "multi-account",
    "ssh",
    "identity",
    "cli",
    "octomux",
    "omx",
    "ssh-config",
    "git-config"
  ],
  "author": "Siam",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Siam777/github-manager.git"
  },
  "bugs": {
    "url": "https://github.com/Siam777/github-manager/issues"
  },
  "homepage": "https://github.com/Siam777/github-manager#readme",
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^0.8.2",
    "boxen": "^8.0.1",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "execa": "^9.3.1",
    "ora": "^8.0.1",
    "picocolors": "^1.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "tsup": "^8.5.1",
    "typescript": "^5.5.4",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
